#!/bin/sh
# The licensed art changed? Its vault is re-packed into the commit (tool/asset_vault.py). And nothing private goes in
# (tool/privacy_check.py). docs/assets.md "The asset vault"; installed by python3 tool/asset_vault.py install-hooks.
python3 tool/asset_vault.py hook pre-commit || exit 1
exec python3 tool/privacy_check.py --staged
