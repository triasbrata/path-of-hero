# Asset packs as downloaded (licensed, big) and what tool/export_aseprite.py generates from them.
/raw_assets/
/sprites/
# The owner's art packs, unpacked as they came (docs/assets.md "Asset packs"): no file of a pack is tracked, images and
# source art (png, gif, aseprite, psd, zip...) included; only this folder's README.md is. Their metadata is
# tool/asset_packs/.
/raw_sprites/*
!/raw_sprites/README.md
# The asset vault (docs/assets.md "The asset vault"): plain pack files are never tracked (above); their encrypted
# vaults in assets-vault/ are, and only tool/asset_vault.py's half-written parts are not.
/assets-vault/*.tmp

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# The itch page GIF's frames: intermediate output of test/probe_itch_shots.dart (docs/itch-page.md)
/marketing/itch/gif/

# scripts/release-build.sh's staged builds, for butler (docs/itch-page.md "Pushing builds")
/dist/

# The licensed art (docs/assets.md "The asset vault"): only its encrypted vaults are tracked;
# tool/asset_vault.py unpacks them (the key), or tool/gen_placeholders.py draws placeholders.
/assets/images/tiny_arrow_*.png
/assets/images/tiny_fx_*.png
/assets/images/tiny_*_shadow.png
/assets/images/tiny_*.png
