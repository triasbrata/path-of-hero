<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive launcher icon (Android 8+), drawn by tool/make_app_icon.py: the sunrise as the background layer,
     the Hero knight with its halo and crown as the foreground, its silhouette for themed icons (Android 13+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
